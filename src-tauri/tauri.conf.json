{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PRISM Worldgen Lab",
  "version": "0.1.5",
  "identifier": "de.fabix.prism.worldgen.lab",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGQTFCRjc4QjI2ODgwNkIKUldScmdHaXllTCtoUDhMVnRYNkNUSGZpSzVCc3dFN1hEeEw5THlvbk83UDZkWE1BYmtFdVBMQ3UK",
      "endpoints": [
        "https://github.com/F-B-Z/PRISM-Minecraft-WorldGen-Lab/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PRISM Worldgen Lab",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
